[data-checkout-prototype="plans-pick-your-plan-3tier"] .lt-seedance { flex-direction: column; align-items: flex-start; gap: 12px; padding: 16px; }
[data-checkout-prototype="plans-pick-your-plan-3tier"] .lt-card-top { flex-direction: column; align-items: flex-start; }
[data-checkout-prototype="plans-pick-your-plan-3tier"] .lt-name { font-size: 24px; }
[data-checkout-prototype="plans-pick-your-plan-3tier"] .lt-trust { gap: 14px; }

}
