[data-checkout-prototype="plans-pick-your-plan-3tier"] .offer-d { font-size: 13.5px; color: var(--fg-muted); line-height: 1.5; margin-top: 4px; }
[data-checkout-prototype="plans-pick-your-plan-3tier"] .offer-v { flex: 0 0 auto; align-self: center; font-family: var(--font-display); font-weight: 800; font-size: 15px; color: var(--gold); white-space: nowrap; padding-left: 10px; }
[data-checkout-prototype="plans-pick-your-plan-3tier"] .offer-anchor { display: flex; align-items: stretch; justify-content: space-between; flex-wrap: wrap; gap: 16px; margin-top: 14px; padding: 22px 24px; border-radius: var(--r-lg);
  border: 1px solid rgba(245,199,126,.3); background: rgba(0,0,0,.28); }
[data-checkout-prototype="plans-pick-your-plan-3tier"] .offer-total { display: flex; flex-direction: column; justify-content: center; gap: 4px; }
[data-checkout-prototype="plans-pick-your-plan-3tier"] .offer-total-lbl { font-family: var(--font-display); font-weight: 700; font-size: 12px; letter-spacing: .1em; text-transform: uppercase; color: var(--fg-subtle); }
[data-checkout-prototype="plans-pick-your-plan-3tier"] .offer-total-amt { font-family: var(--font-display); font-weight: 800; font-size: 30px; color: var(--fg-faint); text-decoration: line-through; text-decoration-color: rgba(248,113,113,.7); text-decoration-thickness: 2px; }
[data-checkout-prototype="plans-pick-your-plan-3tier"] .offer-today { display: flex; flex-direction: column; justify-content: center; text-align: right; }
[data-checkout-prototype="plans-pick-your-plan-3tier"] .offer-today-lbl { font-family: var(--font-display); font-weight: 700; font-size: 12px; letter-spacing: .1em; text-transform: uppercase; color: var(--gold); }
[data-checkout-prototype="plans-pick-your-plan-3tier"] .offer-today-amt { font-family: var(--font-display); font-weight: 800; font-size: 44px; line-height: 1; color: #fff; margin-top: 3px; }
[data-checkout-prototype="plans-pick-your-plan-3tier"] .offer-today-unit { font-size: 20px; color: var(--fg-muted); font-weight: 700; }
[data-checkout-prototype="plans-pick-your-plan-3tier"] .offer-today-note { font-size: 13px; color: var(--fg-muted); margin-top: 7px; }
[data-checkout-prototype="plans-pick-your-plan-3tier"] .offer-cta { width: 100%; margin-top: 14px; border: none; cursor: pointer; border-radius: var(--r-md); padding: 20px; display: flex; align-items: center; justify-content: center; gap: 11px;
  font-family: var(--font-display); font-weight: 800; font-size: 19px; background: var(--grad-gold); color: var(--fg-on-gold);
  box-shadow: 0 20px 48px -18px rgba(245,199,126,.7); transition: filter .15s, transform .1s; }
[data-checkout-prototype="plans-pick-your-plan-3tier"] .offer-cta:hover { filter: brightness(1.06); }
[data-checkout-prototype="plans-pick-your-plan-3tier"] .offer-cta:active { transform: scale(.99); }
[data-checkout-prototype="plans-pick-your-plan-3tier"] .offer-guar { display: flex; align-items: center; justify-content: center; gap: 8px; margin: 14px 0 4px; font-size: 13.5px; color: var(--fg-muted); }
[data-checkout-prototype="plans-pick-your-plan-3tier"] .offer-guar svg { color: var(--green); }
[data-checkout-prototype="plans-pick-your-plan-3tier"] .exit-scrim { position: fixed; inset: 0; z-index: 200; display: flex; align-items: center; justify-content: center; padding: 24px;
  background: rgba(8,6,12,.72); backdrop-filter: blur(6px); animation: exitfade .25s ease; }
@keyframes exitfade { from { opacity: 0; } to { opacity: 1; } }
[data-checkout-prototype="plans-pick-your-plan-3tier"] .exit-card { position: relative; width: 540px; max-width: 100%; text-align: center; border-radius: var(--r-xl); padding: 40px 38px 30px;
  background: linear-gradient(160deg, #181020 0%, #1f1430 55%, #2a1430 100%);
  border: 1px solid rgba(245,199,126,.4);
  box-shadow: 0 50px 130px -40px rgba(217,70,194,.7), inset 0 1px 0 rgba(255,255,255,.06);
  animation: exitpop .35s cubic-bezier(.2,.9,.3,1.2); }
@keyframes exitpop { from { opacity: 0; transform: translateY(18px) scale(.96); } to { opacity: 1; transform: none; } }
[data-checkout-prototype="plans-pick-your-plan-3tier"] .exit-close { position: absolute; top: 16px; right: 16px; width: 36px; height: 36px; border-radius: 10px; cursor: pointer;
  display: flex; align-items: center; justify-content: center; border: 1px solid var(--hairline); background: rgba(255,255,255,.04); color: var(--fg-muted); transition: color .15s, border-color .15s; }
[data-checkout-prototype="plans-pick-your-plan-3tier"] .exit-close:hover { color: #fff; border-color: var(--hairline-strong); }
[data-checkout-prototype="plans-pick-your-plan-3tier"] .exit-pill { display: inline-flex; align-items: center; gap: 7px; font-family: var(--font-display); font-weight: 800; font-size: 12px; letter-spacing: .1em; text-transform: uppercase;
  color: var(--gold); padding: 7px 15px; border-radius: 999px; border: 1px solid rgba(245,199,126,.42); background: rgba(245,199,126,.1); }
[data-checkout-prototype="plans-pick-your-plan-3tier"] .exit-title { font-family: var(--font-display); font-weight: 800; font-size: clamp(28px, 5vw, 38px); letter-spacing: -.02em; color: #fff; line-height: 1.06; margin: 18px 0 0; text-wrap: balance; }
[data-checkout-prototype="plans-pick-your-plan-3tier"] .exit-highlight { display: inline-flex; align-items: center; gap: 9px; margin-top: 14px; font-family: var(--font-display); font-weight: 800; font-size: 18px;
  background: var(--grad-gold); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
[data-checkout-prototype="plans-pick-your-plan-3tier"] .exit-highlight svg { color: var(--gold); -webkit-text-fill-color: var(--gold); }
[data-checkout-prototype="plans-pick-your-plan-3tier"] .exit-bullets { display: flex; flex-direction: column; gap: 9px; max-width: 320px; margin: 22px auto 0; text-align: left; }
[data-checkout-prototype="plans-pick-your-plan-3tier"] .exit-bullet { display: flex; align-items: center; gap: 10px; font-size: 14.5px; color: var(--fg-muted); }
[data-checkout-prototype="plans-pick-your-plan-3tier"] .exit-bullet svg { color: var(--green); flex: 0 0 auto; }
[data-checkout-prototype="plans-pick-your-plan-3tier"] .exit-price { display: flex; flex-direction: column; align-items: center; gap: 2px; margin: 24px 0 0; padding: 18px; border-radius: var(--r-lg); border: 1px solid var(--hairline-strong); background: rgba(0,0,0,.3); }
[data-checkout-prototype="plans-pick-your-plan-3tier"] .exit-price-sub { font-size: 13px; color: var(--fg-subtle); text-transform: uppercase; letter-spacing: .08em; font-weight: 700; font-family: var(--font-display); }
[data-checkout-prototype="plans-pick-your-plan-3tier"] .exit-price-amt { font-family: var(--font-display); font-weight: 800; font-size: 52px; line-height: 1; color: #fff; }
[data-checkout-prototype="plans-pick-your-plan-3tier"] .exit-price-note { font-size: 12.5px; color: var(--fg-muted); margin-top: 4px; }
[data-checkout-prototype="plans-pick-your-plan-3tier"] .exit-cta { width: 100%; margin-top: 20px; border: none; cursor: pointer; border-radius: var(--r-md); padding: 19px; display: flex; align-items: center; justify-content: center; gap: 11px;
  font-family: var(--font-display); font-weight: 800; font-size: 18px; background: var(--grad-gold); color: var(--fg-on-gold);
  box-shadow: 0 20px 48px -18px rgba(245,199,126,.75); transition: filter .15s, transform .1s; }
[data-checkout-prototype="plans-pick-your-plan-3tier"] .exit-cta:hover { filter: brightness(1.06); }
[data-checkout-prototype="plans-pick-your-plan-3tier"] .exit-cta:active { transform: scale(.99); }
[data-checkout-prototype="plans-pick-your-plan-3tier"] .exit-dismiss { display: block; margin: 14px auto 0; border: none; background: none; cursor: pointer; font-size: 13px; color: var(--fg-faint); text-decoration: underline; text-underline-offset: 3px; }
[data-checkout-prototype="plans-pick-your-plan-3tier"] .exit-dismiss:hover { color: var(--fg-muted); }
@media (max-width: 560px) {
[data-checkout-prototype="plans-pick-your-plan-3tier"] .exit-card { padding: 34px 22px 24px; }

}
@media (max-width: 560px) {
[data-checkout-prototype="plans-pick-your-plan-3tier"] .offer-row { gap: 12px; padding: 15px 10px; }
