[data-checkout-prototype="plans-pick-your-plan-3tier"] .guar-band .guar-txt { flex: 0 0 auto; }
[data-checkout-prototype="plans-pick-your-plan-3tier"] .guar-band .guar-cta { margin-top: 4px; }

}
@media (max-width: 560px) {
[data-checkout-prototype="plans-pick-your-plan-3tier"] .flash-cell { width: 62px; padding: 11px 0; }
